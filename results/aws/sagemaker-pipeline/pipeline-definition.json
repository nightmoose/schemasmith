{
    "Version": "2020-12-01",
    "Metadata": {},
    "Parameters": [
        {
            "Name": "Seed",
            "Type": "String",
            "DefaultValue": "1"
        },
        {
            "Name": "TrainInstanceType",
            "Type": "String",
            "DefaultValue": "ml.g5.xlarge"
        },
        {
            "Name": "EvalInstanceType",
            "Type": "String",
            "DefaultValue": "ml.g6.xlarge"
        },
        {
            "Name": "MinContractValid",
            "Type": "Float",
            "DefaultValue": 0.99
        },
        {
            "Name": "MinFieldExactMatch",
            "Type": "Float",
            "DefaultValue": 0.97
        },
        {
            "Name": "MinRefused",
            "Type": "Integer",
            "DefaultValue": 7
        },
        {
            "Name": "ModelApprovalStatus",
            "Type": "String",
            "DefaultValue": "PendingManualApproval"
        }
    ],
    "Steps": [
        {
            "Name": "Train",
            "Type": "Training",
            "Arguments": {
                "AlgorithmSpecification": {
                    "TrainingImage": "763104351884.dkr.ecr.us-east-1.amazonaws.com/pytorch-training:2.8.0-gpu-py312-cu129-ubuntu22.04-sagemaker",
                    "TrainingInputMode": "File",
                    "ContainerEntrypoint": [
                        "bash",
                        "/opt/ml/input/data/code/step_job.sh"
                    ]
                },
                "RoleArn": "arn:aws:iam::065614567889:role/lexsi-sagemaker-exec",
                "OutputDataConfig": {
                    "S3OutputPath": {
                        "Std:Join": {
                            "On": "/",
                            "Values": [
                                "s3://sagemaker-lexsi-065614567889/lexsi-aws/pipeline",
                                {
                                    "Get": "Execution.PipelineExecutionId"
                                },
                                "jobs"
                            ]
                        }
                    }
                },
                "ResourceConfig": {
                    "InstanceType": {
                        "Get": "Parameters.TrainInstanceType"
                    },
                    "InstanceCount": 1,
                    "VolumeSizeInGB": 100
                },
                "StoppingCondition": {
                    "MaxRuntimeInSeconds": 9000
                },
                "InputDataConfig": [
                    {
                        "ChannelName": "code",
                        "DataSource": {
                            "S3DataSource": {
                                "S3DataType": "S3Prefix",
                                "S3Uri": "s3://sagemaker-lexsi-065614567889/lexsi-aws/code/",
                                "S3DataDistributionType": "FullyReplicated"
                            }
                        }
                    }
                ],
                "Environment": {
                    "JOB_KIND": "train",
                    "TAG": "cand",
                    "SEED": {
                        "Get": "Parameters.Seed"
                    }
                },
                "Tags": [
                    {
                        "Key": "project",
                        "Value": "lexsi-aws"
                    }
                ]
            }
        },
        {
            "Name": "Evaluate",
            "Type": "Training",
            "Arguments": {
                "AlgorithmSpecification": {
                    "TrainingImage": "763104351884.dkr.ecr.us-east-1.amazonaws.com/pytorch-training:2.8.0-gpu-py312-cu129-ubuntu22.04-sagemaker",
                    "TrainingInputMode": "File",
                    "ContainerEntrypoint": [
                        "bash",
                        "/opt/ml/input/data/code/step_job.sh"
                    ]
                },
                "RoleArn": "arn:aws:iam::065614567889:role/lexsi-sagemaker-exec",
                "OutputDataConfig": {
                    "S3OutputPath": {
                        "Std:Join": {
                            "On": "/",
                            "Values": [
                                "s3://sagemaker-lexsi-065614567889/lexsi-aws/pipeline",
                                {
                                    "Get": "Execution.PipelineExecutionId"
                                },
                                "jobs"
                            ]
                        }
                    }
                },
                "ResourceConfig": {
                    "InstanceType": {
                        "Get": "Parameters.EvalInstanceType"
                    },
                    "InstanceCount": 1,
                    "VolumeSizeInGB": 100
                },
                "StoppingCondition": {
                    "MaxRuntimeInSeconds": 3600
                },
                "InputDataConfig": [
                    {
                        "ChannelName": "code",
                        "DataSource": {
                            "S3DataSource": {
                                "S3DataType": "S3Prefix",
                                "S3Uri": "s3://sagemaker-lexsi-065614567889/lexsi-aws/code/",
                                "S3DataDistributionType": "FullyReplicated"
                            }
                        }
                    },
                    {
                        "ChannelName": "adapter",
                        "DataSource": {
                            "S3DataSource": {
                                "S3DataType": "S3Prefix",
                                "S3Uri": {
                                    "Get": "Steps.Train.ModelArtifacts.S3ModelArtifacts"
                                },
                                "S3DataDistributionType": "FullyReplicated"
                            }
                        }
                    }
                ],
                "Environment": {
                    "JOB_KIND": "eval"
                },
                "Tags": [
                    {
                        "Key": "project",
                        "Value": "lexsi-aws"
                    }
                ]
            }
        },
        {
            "Name": "PackageAndScore",
            "Type": "Processing",
            "Arguments": {
                "ProcessingResources": {
                    "ClusterConfig": {
                        "InstanceType": "ml.t3.medium",
                        "InstanceCount": 1,
                        "VolumeSizeInGB": 30
                    }
                },
                "AppSpecification": {
                    "ImageUri": "683313688378.dkr.ecr.us-east-1.amazonaws.com/sagemaker-scikit-learn:1.2-1-cpu-py3",
                    "ContainerEntrypoint": [
                        "python3",
                        "/opt/ml/processing/input/code/package_and_score.py"
                    ]
                },
                "RoleArn": "arn:aws:iam::065614567889:role/lexsi-sagemaker-exec",
                "StoppingCondition": {
                    "MaxRuntimeInSeconds": 1800
                },
                "ProcessingInputs": [
                    {
                        "InputName": "code",
                        "AppManaged": false,
                        "S3Input": {
                            "S3Uri": "s3://sagemaker-lexsi-065614567889/lexsi-aws/code/",
                            "LocalPath": "/opt/ml/processing/input/code",
                            "S3DataType": "S3Prefix",
                            "S3InputMode": "File",
                            "S3DataDistributionType": "FullyReplicated"
                        }
                    },
                    {
                        "InputName": "serve",
                        "AppManaged": false,
                        "S3Input": {
                            "S3Uri": "s3://sagemaker-lexsi-065614567889/lexsi-aws/serve-code/",
                            "LocalPath": "/opt/ml/processing/serve",
                            "S3DataType": "S3Prefix",
                            "S3InputMode": "File",
                            "S3DataDistributionType": "FullyReplicated"
                        }
                    },
                    {
                        "InputName": "adapter",
                        "AppManaged": false,
                        "S3Input": {
                            "S3Uri": {
                                "Get": "Steps.Train.ModelArtifacts.S3ModelArtifacts"
                            },
                            "LocalPath": "/opt/ml/processing/adapter",
                            "S3DataType": "S3Prefix",
                            "S3InputMode": "File",
                            "S3DataDistributionType": "FullyReplicated"
                        }
                    },
                    {
                        "InputName": "eval",
                        "AppManaged": false,
                        "S3Input": {
                            "S3Uri": {
                                "Get": "Steps.Evaluate.ModelArtifacts.S3ModelArtifacts"
                            },
                            "LocalPath": "/opt/ml/processing/eval",
                            "S3DataType": "S3Prefix",
                            "S3InputMode": "File",
                            "S3DataDistributionType": "FullyReplicated"
                        }
                    }
                ],
                "ProcessingOutputConfig": {
                    "Outputs": [
                        {
                            "OutputName": "evaluation",
                            "AppManaged": false,
                            "S3Output": {
                                "S3Uri": {
                                    "Std:Join": {
                                        "On": "/",
                                        "Values": [
                                            "s3://sagemaker-lexsi-065614567889/lexsi-aws/pipeline",
                                            {
                                                "Get": "Execution.PipelineExecutionId"
                                            },
                                            "evaluation"
                                        ]
                                    }
                                },
                                "LocalPath": "/opt/ml/processing/evaluation",
                                "S3UploadMode": "EndOfJob"
                            }
                        },
                        {
                            "OutputName": "model",
                            "AppManaged": false,
                            "S3Output": {
                                "S3Uri": {
                                    "Std:Join": {
                                        "On": "/",
                                        "Values": [
                                            "s3://sagemaker-lexsi-065614567889/lexsi-aws/pipeline",
                                            {
                                                "Get": "Execution.PipelineExecutionId"
                                            },
                                            "model"
                                        ]
                                    }
                                },
                                "LocalPath": "/opt/ml/processing/model",
                                "S3UploadMode": "EndOfJob"
                            }
                        }
                    ]
                },
                "Tags": [
                    {
                        "Key": "project",
                        "Value": "lexsi-aws"
                    }
                ]
            },
            "PropertyFiles": [
                {
                    "PropertyFileName": "Evaluation",
                    "OutputName": "evaluation",
                    "FilePath": "evaluation.json"
                }
            ]
        },
        {
            "Name": "CheckContract",
            "Type": "Condition",
            "Arguments": {
                "Conditions": [
                    {
                        "Type": "GreaterThanOrEqualTo",
                        "LeftValue": {
                            "Std:JsonGet": {
                                "PropertyFile": {
                                    "Get": "Steps.PackageAndScore.PropertyFiles.Evaluation"
                                },
                                "Path": "contract_valid_rate"
                            }
                        },
                        "RightValue": {
                            "Get": "Parameters.MinContractValid"
                        }
                    },
                    {
                        "Type": "GreaterThanOrEqualTo",
                        "LeftValue": {
                            "Std:JsonGet": {
                                "PropertyFile": {
                                    "Get": "Steps.PackageAndScore.PropertyFiles.Evaluation"
                                },
                                "Path": "field_exact_match"
                            }
                        },
                        "RightValue": {
                            "Get": "Parameters.MinFieldExactMatch"
                        }
                    },
                    {
                        "Type": "GreaterThanOrEqualTo",
                        "LeftValue": {
                            "Std:JsonGet": {
                                "PropertyFile": {
                                    "Get": "Steps.PackageAndScore.PropertyFiles.Evaluation"
                                },
                                "Path": "hostile_v2_injections_refused"
                            }
                        },
                        "RightValue": {
                            "Get": "Parameters.MinRefused"
                        }
                    }
                ],
                "IfSteps": [
                    {
                        "Name": "Register",
                        "Type": "RegisterModel",
                        "Arguments": {
                            "ModelPackageGroupName": "lexsi-schemasmith",
                            "ModelPackageDescription": "SchemaSmith Tiny Aya LoRA SFT+DPO (pipeline retrain)",
                            "InferenceSpecification": {
                                "Containers": [
                                    {
                                        "Image": "763104351884.dkr.ecr.us-east-1.amazonaws.com/pytorch-inference:2.6.0-gpu-py312-cu124-ubuntu22.04-sagemaker",
                                        "ModelDataUrl": {
                                            "Std:Join": {
                                                "On": "/",
                                                "Values": [
                                                    "s3://sagemaker-lexsi-065614567889/lexsi-aws/pipeline",
                                                    {
                                                        "Get": "Execution.PipelineExecutionId"
                                                    },
                                                    "model",
                                                    "model.tar.gz"
                                                ]
                                            }
                                        },
                                        "Environment": {
                                            "SAGEMAKER_PROGRAM": "inference.py",
                                            "SAGEMAKER_SUBMIT_DIRECTORY": "/opt/ml/model/code"
                                        }
                                    }
                                ],
                                "SupportedContentTypes": [
                                    "application/json"
                                ],
                                "SupportedResponseMIMETypes": [
                                    "application/json"
                                ],
                                "SupportedRealtimeInferenceInstanceTypes": [
                                    "ml.g5.xlarge",
                                    "ml.g6.xlarge"
                                ]
                            },
                            "ModelApprovalStatus": {
                                "Get": "Parameters.ModelApprovalStatus"
                            },
                            "ModelMetrics": {
                                "ModelQuality": {
                                    "Statistics": {
                                        "ContentType": "application/json",
                                        "S3Uri": {
                                            "Std:Join": {
                                                "On": "/",
                                                "Values": [
                                                    "s3://sagemaker-lexsi-065614567889/lexsi-aws/pipeline",
                                                    {
                                                        "Get": "Execution.PipelineExecutionId"
                                                    },
                                                    "evaluation",
                                                    "model_quality.json"
                                                ]
                                            }
                                        }
                                    }
                                }
                            },
                            "CustomerMetadataProperties": {
                                "source": "pipeline",
                                "seed": {
                                    "Get": "Parameters.Seed"
                                }
                            }
                        }
                    }
                ],
                "ElseSteps": [
                    {
                        "Name": "GateFailed",
                        "Type": "Fail",
                        "Arguments": {
                            "ErrorMessage": "Candidate missed the contract/field-match/injection gate"
                        }
                    }
                ]
            }
        }
    ]
}
