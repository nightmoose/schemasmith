{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemasmith://contracts/support_ticket.schema.json",
  "title": "support_ticket",
  "description": "One support ticket extracted from a customer message. refund_amount_usd must be null unless category is billing. language is an ISO 639-1 code.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ticket_id",
    "customer_tier",
    "category",
    "severity",
    "order_ref",
    "refund_amount_usd",
    "language"
  ],
  "properties": {
    "ticket_id": {
      "type": "string",
      "pattern": "^T-[A-Za-z0-9]+$",
      "description": "Ticket identifier copied from the source text."
    },
    "customer_tier": {
      "type": "string",
      "enum": [
        "free",
        "pro",
        "enterprise"
      ]
    },
    "category": {
      "type": "string",
      "enum": [
        "billing",
        "bug",
        "access",
        "feature_request"
      ]
    },
    "severity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "order_ref": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^ORD-\\d{6}$",
      "description": "Order reference copied from the source text, or null."
    },
    "refund_amount_usd": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "description": "Refund amount in USD. Null unless category is billing."
    },
    "language": {
      "type": "string",
      "enum": [
